---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import profile from '../data/profile.json';
import portfolio from '../data/portfolio.json';
import services from '../data/services.json';
import oss from '../data/opensource.json';
import posts from '../data/posts.json';
import RepoCard from '../components/RepoCard.astro';
import Metrics from '../components/Metrics.astro';

const pub = portfolio.projects.filter((p) => p.visibility === 'public');
const inProd = pub.filter((p) => p.status === 'Maintained').length;
const delivered = pub.filter((p) => ['Shipped', 'Maintained'].includes(p.status)).length;
// Rolling delivery counter for the current fiscal quarter. Generated by the private tracker
// (portfolio.deliveries); the same numbers appear on the GitHub profile card and /work/timeline/.
const quarters = (portfolio as any).deliveries?.quarters ?? [];
const q = quarters.find((x: any) => x.current) ?? quarters[0];
const prevQ = q ? quarters[quarters.indexOf(q) + 1] : undefined;
const latest = q ? q.items.slice(0, 5) : [];
const fmtD = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', o);
const clause = (n: string) => n.split(';')[0].replace(/\s*\([^)]*\)\s*$/, '').trim();
const featured = ['filegate', 'uw-triage', 'license-exam-prep']
  .map((n) => pub.find((p) => p.name === n)).filter(Boolean);
const pillarIcons = ['shield', 'flow', 'chart'];
const valueIcons = ['target', 'person', 'lotus'];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{profile.name} · {profile.brand.name}</p>
        <h1>Operational clarity <span class="accent">at scale.</span></h1>
        <p class="who">{profile.title} at {profile.employer}</p>
        <p class="lede">I own systems architecture, automation, data governance and cybersecurity at an Allstate agency in {profile.location}, and I build the internal tools the team runs on: a file-compliance auditor, AI-assisted triage, training apps and the workflows that connect them.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/work/">View work <Icon name="arrow" class="i" /></a>
          <a class="btn btn--ghost" href="/resume/">Resume</a>
          <a class="btn btn--ghost" href="/contact/">Contact</a>
        </div>
        <p class="social-label" id="find-me">Find me online</p>
        <SocialLinks label="Find me online" />
      </div>
      <Mark class="hero-mark" />
    </div>
    <div class="wrap">
      <div class="proof" role="list" aria-label="At a glance">
        <div role="listitem"><strong>{delivered}</strong><span>projects delivered: software, infrastructure and operations</span></div>
        <div role="listitem"><strong>{inProd}</strong><span>in daily production and actively maintained</span></div>
        <div role="listitem"><strong>154</strong><span>passing automated tests across 4 apps (FileGate, training, exam prep, past-due tracker)</span></div>
        <div role="listitem"><strong>2016</strong><span>started in Salesforce systems administration</span></div>
      </div>
    </div>
  </section>

  {q && (
  <section class="section" aria-labelledby="quarter-h">
    <div class="wrap">
      <p class="eyebrow">Delivery tracker</p>
      <h2 id="quarter-h">{q.label}: {q.total} delivered so far</h2>
      <p class="lede">{q.new} new {q.new === 1 ? 'system' : 'systems'} and {q.improvements} {q.improvements === 1 ? 'improvement' : 'improvements'} shipped since {fmtD(q.start, { month: 'long', day: 'numeric' })}, with {100 - q.pct_elapsed}% of the quarter still to go.{prevQ && ` ${prevQ.label} finished at ${prevQ.total}.`}</p>
      <div class="score">
        <div class="score-stats">
          <Metrics items={[{ value: String(q.total), label: 'delivered this quarter' }, { value: String(q.new), label: q.new === 1 ? 'new system launched' : 'new systems launched' }, { value: String(q.improvements), label: 'releases and improvements' }]} label={`${q.label} delivery scorecard`} />
          <div class="bar" role="img" aria-label={`${q.pct_elapsed}% of ${q.label} elapsed`}><span style={`width:${q.pct_elapsed}%`}></span></div>
          <p class="small muted">{q.pct_elapsed}% of the quarter elapsed · {fmtD(q.start, { month: 'short', day: 'numeric' })} – {fmtD(q.end, { month: 'short', day: 'numeric', year: 'numeric' })} · counted as of {fmtD(q.as_of, { month: 'short', day: 'numeric', year: 'numeric' })}</p>
        </div>
        <div class="score-latest">
          <h3>Latest</h3>
          <ol class="tl tl--compact">
            {latest.map((it: any) => (
              <li><time datetime={it.date}>{fmtD(it.date, { month: 'short', day: 'numeric' })}</time><span><a href={`/work/${it.name}/`}>{it.title}</a> <span class="muted">— {it.kind === 'new' ? 'shipped' : clause(it.note)}</span></span></li>
            ))}
          </ol>
          <a class="btn btn--ghost" href="/work/timeline/">Full delivery timeline <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
  )}

  <section class="section section--alt" aria-labelledby="pillars-h">
    <div class="wrap">
      <h2 id="pillars-h" class="sr-only">What the work stands for</h2>
      <div class="pillars">
        {profile.brand.pillars.map((p, i) => (
          <div class="pillar"><Icon name={pillarIcons[i]} /><div><h3>{p.title}</h3><p>{p.text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-h">Systems that ship, not slideware</h2>
      <p class="lede">Each project has a written case study. Source code is private; walkthroughs are available on request.</p>
      <div class="grid grid--3" style="margin-top:2rem">
        {featured.map((p) => <ProjectCard p={p} showImage={false} />)}
      </div>
      <div class="btn-row"><a class="btn btn--ghost" href="/work/">All {pub.length} projects and case studies <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="oss-home-h">
    <div class="wrap">
      <p class="eyebrow">Open source</p>
      <h2 id="oss-home-h">Code you can read today</h2>
      <p class="lede">Production source stays private. These {oss.repos.length} public tools distill the same patterns, with tests on every push.</p>
      <div class="grid grid--2" style="margin-top:2rem">{oss.repos.map((r) => <RepoCard r={r} />)}</div>
      <div class="btn-row"><a class="btn btn--ghost" href="/writing/">Read the technical write-ups ({posts.posts.length}) <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">How I work</p>
        <h2 id="how-h">Clarity first, then automation</h2>
      </div>
      <div class="pillars" style="grid-template-columns:1fr">
        {profile.brand.values.map((v, i) => (
          <div class="pillar"><Icon name={valueIcons[i]} /><div><h3>{v.title}</h3><p>{v.text}</p></div></div>
        ))}
        <p class="muted">In practice: policies get written down as data before code enforces them, anything that can't be derived goes to a review queue instead of being guessed, and the larger tools ship with automated tests.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="svc-h">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h2 id="svc-h">Need this kind of clarity in your business?</h2>
      <p class="lede">{services.intro}</p>
      <div class="grid grid--2" style="margin-top:2rem">
        {services.offers.map((o) => (
          <article class="card">
            <h3><a href={`/services/#${o.id}`}>{o.title}</a></h3>
            <p class="price">{o.price}{' '}<small>{o.priceNote}</small></p>
            <p>{o.summary}</p>
            <div class="foot"><a href={`/services/#${o.id}`}>What's included<span class="sr-only">: {o.title}</span></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import portfolio from '../../data/portfolio.json';
import oss from '../../data/opensource.json';
import RepoCard from '../../components/RepoCard.astro';
import redesigns from '../../data/redesigns.json';
import designs from '../../data/designs.json';

const pub = portfolio.projects.filter((p) => p.visibility === 'public');
const groups = [
  { id: 'production', title: 'In production', items: pub.filter((p) => p.status === 'In production') },
  { id: 'apps', title: 'Desktop apps & training systems', items: pub.filter((p) => ['license-exam-prep', 'training-program', 'training-video-pipeline'].includes(p.name)) },
  { id: 'automation', title: 'Automation, web & design tooling', items: pub.filter((p) => ['apps-script-toolkit', 'sdr-talk-path', 'design-system'].includes(p.name)) },
  { id: 'infra', title: 'Infrastructure & IT operations', items: pub.filter((p) => ['Infrastructure', 'Operations'].includes(p.lang)) },
  { id: 'progress', title: 'In progress', items: pub.filter((p) => p.status === 'In progress' && !['Infrastructure', 'Operations'].includes(p.lang)) },
];
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Projects by Forrest Swan III',
  itemListElement: pub.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://forrestswan3.github.io/work/${p.name}/`, name: p.title })),
};
---
<Base title="Work" description="Internal software, workflow automation, compliance tooling and training systems for insurance agency operations, with case studies. Source code is private; walkthroughs on request." jsonld={[itemList]}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Work</p>
      <h1 style="font-size:var(--step-3)">Projects & case studies</h1>
      <p class="lede">{pub.length} projects across software, infrastructure and operations, each with a written case study. Production source code is private and available for walkthrough on request; <a href="#open-source">{oss.repos.length} companion tools are open source</a>.</p>
      <p class="notice">Case studies describe systems at a design level: staff names, IDs and network details are omitted, and no client data is shown.</p>

      {groups.map((g) => g.items.length > 0 && (
        <section aria-labelledby={`g-${g.id}`} style="margin-top:3rem">
          <h2 id={`g-${g.id}`} style="font-size:var(--step-2)">{g.title}</h2>
          <div class="grid grid--3">{g.items.map((p) => <ProjectCard p={p} />)}</div>
        </section>
      ))}

      <section id="redesigns" aria-labelledby="rd-h" style="margin-top:4rem">
        <p class="eyebrow">Small-business websites</p>
        <h2 id="rd-h" style="font-size:var(--step-2)">Website redesign concepts</h2>
        <p class="lede">Unsolicited sample redesigns for {redesigns.concepts.length} local Florida businesses whose current sites had problems. Each got a one-page and a five-page version, built from the facts on its existing site.</p>
        <p class="notice">Shown without business names, phone numbers or links until the owner agrees. Screenshots use placeholders in place of each business's details. Last updated {fmt(redesigns.updated)}.</p>
        <div class="grid grid--3" style="margin-top:1.5rem">
          {redesigns.concepts.map((c) => (
            <article class="card">
              <div class="card-img"><img src={c.image} alt={c.alt} width="960" height="600" loading="lazy" decoding="async" /></div>
              <div class="meta"><span class="pill">Concept</span><span class="pill">{fmt(c.date)}</span></div>
              <h3>{c.title}</h3>
              <p>Problems the redesign addresses: {c.fixes.join(', ')}.</p>
              <ul class="tags" aria-label="Versions built">{c.built.map((b) => <li>{b}</li>)}</ul>
            </article>
          ))}
        </div>
        <h3 style="margin-top:2.5rem">Demo sites (fictional businesses)</h3>
        <p class="lede">Invented businesses with invented details, so the full builds can be opened.</p>
        <div class="grid grid--3" style="margin-top:1.5rem">
          {redesigns.demos.map((d) => (
            <article class="card">
              <div class="card-img"><img src={d.image} alt={d.alt} width="960" height="600" loading="lazy" decoding="async" /></div>
              <div class="meta"><span class="pill">Demo</span><span class="pill">{d.trade}</span></div>
              <h4 style="font-size:var(--step-1)">{d.title}</h4>
              <p>{d.blurb}</p>
              <div class="foot">
                <a href={d.one_page}>One-page site<span class="sr-only">: {d.title}</span></a>
                <a href={d.five_page}>Five-page site<span class="sr-only">: {d.title}</span></a>
              </div>
            </article>
          ))}
        </div>
        <p style="margin-top:1.5rem"><a href="/services/#websites">Website pricing</a> · <a href="/work/website-outreach-pipeline/">How these samples are built</a></p>
      </section>

      <section id="designs" aria-labelledby="ds-h" style="margin-top:4rem">
        <p class="eyebrow">Graphic design</p>
        <h2 id="ds-h" style="font-size:var(--step-2)">Minimalist apparel designs</h2>
        <p class="lede">{designs.designs.length} original vector designs built from early Christian symbols (Chi-Rho, staurogram, Alpha and Omega, IC XC NIKA). Each is drawn as SVG and exported as a 4500 × 5400 px print file in two inks, one for light garments and one for dark.</p>
        <p class="notice">The symbols are public domain; the artwork is original. Scripture text is from the King James Version. Last updated {fmt(designs.updated)}.</p>
        <div class="grid grid--3" style="margin-top:1.5rem">
          {designs.designs.map((x) => (
            <article class="card">
              <div class="card-img"><img src={x.image} alt={x.alt} width="960" height="600" loading="lazy" decoding="async" /></div>
              <h3>{x.title}</h3>
              <p>{x.blurb}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="open-source" aria-labelledby="oss-h" style="margin-top:4rem">
        <p class="eyebrow">Open source</p>
        <h2 id="oss-h" style="font-size:var(--step-2)">Public tools, MIT licensed</h2>
        <p class="lede">Clean-room, organization-free versions of patterns from the projects above. Each repository has automated tests or linting on every push.</p>
        <div class="grid grid--2" style="margin-top:1.5rem">{oss.repos.map((r) => <RepoCard r={r} />)}</div>
      </section>

      <section id="case-studies" aria-labelledby="cs-h" style="margin-top:4rem">
        <p class="eyebrow">Documentation case studies</p>
        <h2 id="cs-h" style="font-size:var(--step-2)">Programs delivered as documentation, not code</h2>
        <div class="grid grid--3">
          {portfolio.case_studies.map((c) => (
            <article class="card">
              <div class="meta"><span class="pill">{c.status}</span><span class="pill">{fmt(c.date)}</span></div>
              <h3>{c.title}</h3>
              <p>{c.summary}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>
</Base>

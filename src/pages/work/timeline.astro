---
import Base from '../../layouts/Base.astro';
import Metrics from '../../components/Metrics.astro';
import portfolio from '../../data/portfolio.json';

// Every dated delivery, grouped by fiscal quarter, newest first. Generated by the private project tracker
// (portfolio.deliveries): a delivery is either a project's ship date or a dated release record from a
// deploy record or change log. Status confirmations are not counted.
const quarters: any[] = (portfolio as any).deliveries?.quarters ?? [];
const titles = new Map(portfolio.projects.map((p) => [p.name, p]));
const fmt = (d: string, o: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' }) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', o);
const clause = (n: string) => n.split(';').map((s) => s.replace(/\s*\([^)]*\)\s*$/, '').trim()).filter(Boolean);
const all = quarters.reduce((n, q) => n + q.total, 0);
const first = quarters.length ? quarters[quarters.length - 1] : null;
const ld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Delivery timeline, Forrest Swan III',
  itemListElement: quarters.flatMap((q) => q.items).slice(0, 50).map((it: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: `${it.date}: ${it.title}`, url: `https://forrestswan3.github.io/work/${it.name}/` })),
};
---
<Base title="Delivery timeline" description={`Every dated project delivery and release, quarter by quarter: ${all} deliveries across ${quarters.length} quarters, generated from the project tracker.`} jsonld={[ld]}>
  <section class="section">
    <div class="wrap" style="max-width:900px">
      <p class="eyebrow"><a href="/work/">Work</a> / Delivery timeline</p>
      <h1 style="font-size:var(--step-3)">What shipped, quarter by quarter</h1>
      <p class="lede">{all} dated deliveries since {first ? fmt(first.start, { month: 'long', year: 'numeric' }) : 'the start'}: new systems going live and the releases that followed. Each line links to the case study.</p>
      <p class="notice">A delivery is a project's go-live date or a dated release record (a deploy record or change log) in the private project tracker. Status confirmations are not counted. The current quarter is a rolling count and regenerates whenever the tracker is updated; the same numbers appear on the <a href="https://github.com/forrestswan3">GitHub profile</a>.</p>

      {quarters.map((q) => (
        <section class="quarter" aria-labelledby={`q-${q.label.replace(/\W+/g, '-')}`}>
          <div class="quarter-head">
            <h2 id={`q-${q.label.replace(/\W+/g, '-')}`} style="font-size:var(--step-2)">{q.label}{q.current && <span class="pill pill--live" style="margin-left:.6rem;vertical-align:middle">In progress</span>}</h2>
            <p class="muted">{fmt(q.start)} – {fmt(q.end, { month: 'short', day: 'numeric', year: 'numeric' })}</p>
          </div>
          <Metrics items={[{ value: String(q.total), label: 'delivered' }, { value: String(q.new), label: q.new === 1 ? 'new system' : 'new systems' }, { value: String(q.improvements), label: q.improvements === 1 ? 'improvement' : 'improvements' }]} label={`${q.label} totals`} />
          {q.current && (
            <>
              <div class="bar" role="img" aria-label={`${q.pct_elapsed}% of ${q.label} elapsed`} style="margin-top:1rem"><span style={`width:${q.pct_elapsed}%`}></span></div>
              <p class="small muted">{q.pct_elapsed}% of the quarter elapsed, counted as of {fmt(q.as_of, { month: 'long', day: 'numeric', year: 'numeric' })}.</p>
            </>
          )}
          {q.items.length > 0 ? (
            <ol class="tl">
              {q.items.map((it: any) => {
                const p: any = titles.get(it.name);
                const parts = it.kind === 'new' ? [p?.status === 'In Progress' ? 'First release live' : 'Shipped'] : clause(it.note);
                return (
                  <li>
                    <time datetime={it.date}>{fmt(it.date)}</time>
                    <div>
                      <span class={`pill ${it.kind === 'new' ? 'pill--live' : ''}`}>{it.kind === 'new' ? 'New' : 'Release'}</span>
                      <a href={`/work/${it.name}/`}>{it.title}</a>
                      <ul class="tl-notes">{parts.map((s: string) => <li>{s}</li>)}</ul>
                    </div>
                  </li>
                );
              })}
            </ol>
          ) : (
            <p class="muted">Nothing delivered yet this quarter.</p>
          )}
        </section>
      ))}
    </div>
  </section>
</Base>

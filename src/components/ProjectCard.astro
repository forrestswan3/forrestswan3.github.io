---
import Icon from './Icon.astro';
interface Props { p: any; showImage?: boolean; headingLevel?: 'h2' | 'h3' }
const { p, showImage = true, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const fmt = (d: string | null) => d ? new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : null;
const hasPreview = showImage && p.preview;
---
<article class="card">
  {hasPreview && (
    <div class="card-img"><img src={`/previews/${p.name}.webp`} alt={`Screenshot of ${p.title}`} width="960" height="600" loading="lazy" decoding="async" /></div>
  )}
  <div class="meta">
    <span class={p.status === 'In production' ? 'pill pill--live' : 'pill'}>{p.status}</span>
    {p.shipped && <span class="pill">{fmt(p.shipped)}</span>}
  </div>
  <H><a href={`/work/${p.name}/`}>{p.title}</a></H>
  <p>{p.tagline}</p>
  <ul class="tags" aria-label="Technologies">{p.topics.slice(0, 5).map((t: string) => <li>{t}</li>)}</ul>
  <div class="foot">
    <a href={`/work/${p.name}/`}>Case study<span class="sr-only">: {p.title}</span></a>
    {p.demo && <a href={p.demo.url}>{p.demo.kind === 'live' ? 'Live demo' : 'Interface'}<span class="sr-only">: {p.title}</span></a>}
    <a href={p.repo}>Source<span class="sr-only">: {p.title}</span></a>
  </div>
</article>
